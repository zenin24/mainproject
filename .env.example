# Chest X-ray Finding Analyzer — Environment Variables Template
# Copy this file to .env and adjust as needed for production deployment.

# Application Settings
APP_TITLE="Chest X-ray Finding Analyzer API"
APP_VERSION="1.0.0"
DEBUG=False

# Model Settings
